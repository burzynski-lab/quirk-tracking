#!/bin/bash
#SBATCH --job-name=hepattn-env
#SBATCH --partition=ouheptmp
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --output=@SCRATCH@/logs/env_%j.out
set -x
QT=@QT@
S=@SCRATCH@
export APPTAINER_CACHEDIR=$S/apptainer-cache
export APPTAINER_TMPDIR=/tmp/$USER-apptainer; mkdir -p $APPTAINER_TMPDIR
[ -f $S/containers/pixi.sif ] || apptainer pull $S/containers/pixi.sif docker://ghcr.io/prefix-dev/pixi:0.54.1-jammy-cuda-12.8.1 || exit 1
apptainer exec --nv --bind /ourdisk,/home \
  --env PIXI_HOME=$S/pixi-home --env PIXI_CACHE_DIR=$S/pixi-cache \
  $S/containers/pixi.sif bash -c "
    pixi config set --global detached-environments $S/envs
    cd $QT/hepattn && pixi install --locked || exit 1
    pixi run python -c 'import torch; print(\"torch\", torch.__version__, \"cuda\", torch.cuda.is_available())'
  "
echo ENVDONE
